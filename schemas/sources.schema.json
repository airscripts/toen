{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SourcesFile",
  "type": "object",
  "required": [
    "source"
  ],
  "properties": {
    "source": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Source"
      }
    }
  },
  "definitions": {
    "HttpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "Source": {
      "type": "object",
      "required": [
        "id",
        "local_attestation",
        "name",
        "url"
      ],
      "properties": {
        "archive_url": {
          "format": "uri",
          "anyOf": [
            {
              "$ref": "#/definitions/HttpsUrl"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "local_attestation": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "format": "uri",
          "allOf": [
            {
              "$ref": "#/definitions/HttpsUrl"
            }
          ]
        }
      }
    }
  }
}
